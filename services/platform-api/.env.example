# Required
DATABASE_URL=postgresql://fashion:fashion@localhost:5432/fashion_studio
ADMIN_API_TOKEN=replace-with-a-long-random-secret
STORAGE_SIGNING_SECRET=replace-with-at-least-32-random-characters

# Runtime
PORT=8787
APP_VERSION=dev
ALLOWED_ORIGINS=http://localhost:4173
MAX_BODY_BYTES=262144
MAX_ASSET_BYTES=15000000
UPLOAD_TTL_SECONDS=900
STORAGE_ROOT=./tmp/platform-storage

# Worker — optional; real provider handlers activate only when the key exists
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_VISION_MODEL=gpt-5.4-mini
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=high
WORKER_ID=worker-local
WORKER_POLL_MS=500
WORKER_LEASE_SECONDS=30

# Wardrobe migration
WARDROBE_DATA_DIR=../wardrobe/data
MIGRATION_PROJECT_ID=project-sol
