{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fashion-studio-sol.dev/schemas/ai-closet-module/0.2.0",
  "title": "AI Closet Module",
  "description": "Contrato portable para prendas, jobs y gateway AI Closet dentro de Fashion Studio SOL.",
  "type": "object",
  "required": ["closetItem", "closetLook", "gateway"],
  "properties": {
    "closetItem": {
      "type": "object",
      "required": ["id", "sourceImage", "createdAt", "updatedAt", "processingStatus"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sourceImage": { "type": "string", "minLength": 1 },
        "transparentImage": { "type": ["string", "null"] },
        "modeledImage": { "type": ["string", "null"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "category": { "type": "string" },
        "subcategory": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "colors": { "type": "array", "items": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" } },
        "season": { "type": "array", "items": { "type": "string" } },
        "occasion": { "type": "array", "items": { "type": "string" } },
        "brand": { "type": "string" },
        "price": { "type": ["number", "null"], "minimum": 0 },
        "currency": { "type": ["string", "null"], "minLength": 3, "maxLength": 3 },
        "processingStatus": {
          "type": "object",
          "required": ["backgroundRemoval", "categorization", "tryOn"],
          "properties": {
            "backgroundRemoval": { "enum": ["pending", "processing", "completed", "error"] },
            "categorization": { "enum": ["pending", "processing", "completed", "error"] },
            "tryOn": { "enum": ["not_requested", "queued", "processing", "completed", "error"] }
          },
          "additionalProperties": false
        },
        "processingError": { "type": "object" }
      },
      "additionalProperties": true
    },
    "gateway": {
      "type": "object",
      "required": ["basePath", "endpoints"],
      "properties": {
        "basePath": { "type": "string", "pattern": "^/api/" },
        "endpoints": {
          "type": "array",
          "items": {
            "enum": [
              "categorize",
              "remove-background",
              "try-on",
              "try-on-status",
              "try-on-result",
              "try-on-purge"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "closetLook": {
      "type": "object",
      "required": ["id", "name", "garmentIds", "status", "createdAt", "updatedAt"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "garmentIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "status": { "enum": ["draft", "review", "approved", "rejected", "published"] },
        "occasion": { "type": "array", "items": { "type": "string" } },
        "season": { "type": "array", "items": { "type": "string" } },
        "style": { "type": ["string", "null"] },
        "canvas": {
          "type": ["object", "null"],
          "properties": {
            "coordinateSystem": { "const": "normalized/v1" },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["garmentId", "x", "y", "scale", "rotation", "zIndex"],
                "properties": {
                  "garmentId": { "type": "string", "minLength": 1 },
                  "x": { "type": "number", "minimum": 0, "maximum": 1 }, "y": { "type": "number", "minimum": 0, "maximum": 1 }, "scale": { "type": "number", "minimum": 0.1, "maximum": 5 }, "rotation": { "type": "number", "minimum": -360, "maximum": 360 }, "zIndex": { "type": "integer" }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
